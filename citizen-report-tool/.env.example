# Active backend: Supabase
# Project Settings > API in your Supabase dashboard

# Server-side only (Vercel functions) — never exposed to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Exposed to the browser bundle (Vite inlines VITE_* vars at build time).
# The anon key is safe to expose — it has no table access (RLS has no anon
# policies) and media uploads are authorized per-file via signed URL tokens
# minted server-side, not by this key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: shown in the "add backup email" UI so users with a confirmed
# email know where to write for manual account recovery. Leave unset to hide
# that line (the backup-email feature still works without it).
VITE_SUPPORT_EMAIL=

# Box app credentials (Service Account, App Access Only)
# Not currently used — kept for when Box app authorization is complete.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_ROOT_FOLDER_ID=
